<?xml version="1.0"?>
<package format="2">
  <name>hps3d160_max</name>
  <version>0.1.0</version>
  <description>Max-utilization system for Hypersen HPS-3D160-U (USB + IO) depth camera: continuous capture, ROI, filters, point cloud publishing/recording, multi-camera, health monitoring.</description>

  <maintainer email="thiagohy@example.com">thiagohy</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>pcl_conversions</build_depend>
  <build_depend>pcl_ros</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
  </export>
</package>